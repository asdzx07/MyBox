[Unit]
Description=BoxPilot 面板
Documentation=https://github.com/asdzx07/boxpilot
After=network-online.target
Wants=network-online.target
Before=boxpilot-kernel.service

[Service]
Type=simple
WorkingDirectory=/opt/boxpilot
ExecStart=/usr/bin/env node /opt/boxpilot/server/index.mjs
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
