[Unit]
Description=MyBox 面板
Documentation=https://github.com/asdzx07/mybox
After=network-online.target
Wants=network-online.target
Before=mybox-kernel.service

[Service]
Type=simple
WorkingDirectory=/opt/mybox
ExecStart=/usr/bin/env node /opt/mybox/server/index.mjs
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
